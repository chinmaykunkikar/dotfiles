#!/bin/bash

git-delete-branches() {
    # Check if we're in a git repository
    if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        echo -e "\033[1;31mNot in a git repository\033[0m"
        return 1
    fi

    # Check if fzf is installed
    if ! command -v fzf >/dev/null 2>&1; then
        echo -e "\033[1;31mfzf is not installed. Please install it with 'brew install fzf'\033[0m"
        return 1
    fi

    local current_branch=$(git branch --show-current)

    local branches_to_delete=$(
        # Get branches with their last commit dates, sort by date (oldest first)
        git for-each-ref --sort=committerdate refs/heads/ --format='%(refname:short)|%(committerdate:relative)|%(committerdate:unix)' |
            grep -v "$current_branch" |
            sort -t'|' -k3 -n |
            awk -F'|' '{print $1 "  \033[2;37m(" $2 ")\033[0m"}' |
            fzf --multi \
                --height=60% \
                --layout=reverse \
                --border=rounded \
                --ansi \
                --prompt="Select branches to delete: " \
                --header="TAB/SPACE to select, ENTER to confirm, ESC to cancel
→ Use ctrl-a to select all
→ Use ctrl-d to deselect all" \
                --preview-window="right:65%" \
                --bind="space:toggle,tab:toggle" \
                --preview='
                branch=$(echo {} | cut -d" " -f1) &&
                echo -e "\033[1;33m🕒 Last commit:\033[0m" &&
                git log -1 --color --pretty=format:"%C(bold blue)%h%C(reset) - %C(green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)" $branch &&
                echo -e "\n\n\033[1;33m📈 Changes vs master:\033[0m" &&
                echo -e "\033[0;36m→ Commits behind master: \033[1;37m$(git rev-list --count $branch..master)\033[0m" &&
                echo -e "\033[0;36m→ Commits ahead of master: \033[1;37m$(git rev-list --count master..$branch)\033[0m" &&
                echo -e "\n\033[1;33m⌛ Branch age:\033[0m" &&
                echo -e "\033[0;36m→ Created: \033[1;37m$(git log --date=relative --format="%ad" $branch --reverse | head -1)\033[0m" &&
                echo -e "\033[0;36m→ Last activity: \033[1;37m$(git log -1 --date=relative --format="%ad" $branch)\033[0m" &&
                echo -e "\n\033[1;33m📝 File changes:\033[0m" &&
                git --no-pager diff --stat --color master...$branch |
                sed "s/^/  /"
            ' \
                --bind="ctrl-a:select-all" \
                --bind="ctrl-d:deselect-all" |
            cut -d" " -f1 # Extract just the branch name from the selection
    )

    if [ -n "$branches_to_delete" ]; then
        echo -e "\n\033[1;33mSelected branches to delete:\033[0m"
        echo -e "$branches_to_delete" | while read branch; do
            local last_commit=$(git log -1 --format="%cr" "$branch")
            echo -e "\033[1;31m$branch\033[0m \033[2;37m(last commit: $last_commit)\033[0m"
        done

        echo -e "\n\033[1;37mAre you sure you want to delete these branches? [y/N]:\033[0m"
        read -r response

        if [[ "$response" =~ ^[Yy]$ ]]; then
            echo "$branches_to_delete" | while read branch; do
                if git branch -D "$branch"; then
                    echo -e "\033[1;32m✓ Successfully deleted branch: $branch\033[0m"
                else
                    echo -e "\033[1;31m✗ Failed to delete branch: $branch\033[0m"
                fi
            done
        else
            echo -e "\033[1;33mOperation cancelled\033[0m"
        fi
    else
        echo -e "\033[1;33mNo branches selected\033[0m"
    fi
}

# For direct script execution
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    git-delete-branches
fi
