// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "git_panel": {
    "tree_view": false
  },
  "auto_update_extensions": {
    "vue": false
  },
  "collaboration_panel": {
    "dock": "right",
  },
  "icon_theme": "Colored Zed Icons Theme Dark",
  "node": {
    "npm_path": "yarn",
  },
  "preview_tabs": {
    "enabled": false,
  },
  "sticky_scroll": {
    "enabled": true,
  },
  "minimap": {
    "show": "auto",
    "thumb": "always",
  },
  "cursor_shape": "bar",
  "autosave": "on_focus_change",
  "buffer_font_fallbacks": ["monospace", "monospace"],
  "buffer_font_family": "JetBrains Mono",
  "file_types": {
    "tailwindcss": ["*.css"],
    "env": [".env", ".env.*"],
  },
  "show_completions_on_input": true,
  "linked_edits": true,
  "show_whitespaces": "none",
  "session": {
    "trust_all_worktrees": true,
  },
  "base_keymap": "VSCode",
  "theme": "One Dark Pro",
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "ui_font_size": 13,
  "buffer_font_size": 13,
  "format_on_save": "on",
  "formatter": "prettier",
  "lsp": {
    "vue-language-server": {
      "settings": {
        "vue": {
          "complete": {
            "normalizeComponentImportName": false
          }
        }
      }
    }
  },
  "languages": {
    "Vue": {
      "format_on_save": "on",
      "formatter": { "language_server": { "name": "ESLint" } },
      "language_servers": ["ESLint", "!vue-language-server", "..."],
    },
    "JavaScript": {
      "format_on_save": "on",
      "formatter": { "language_server": { "name": "ESLint" } },
    },
    "TypeScript": {
      "format_on_save": "on",
      "formatter": { "language_server": { "name": "ESLint" } },
    },
    "JSON": {
      "format_on_save": "on",
      "formatter": "prettier",
    },
    "SCSS": {
      "format_on_save": "on",
      "formatter": "prettier",
    },
    "CSS": {
      "format_on_save": "on",
      "formatter": "prettier",
    },
  },
}
